# Optional hosted Auth integration is pinned to Vendrith Non-Production.
# A separate explicit flag permits loopback-only local E2E; production rejects it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to 1 only for local loopback E2E (127.0.0.1:54321); ignored in production.
NEXT_PUBLIC_ALLOW_LOCAL_SUPABASE_E2E=0
